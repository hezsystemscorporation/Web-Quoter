{
  "manifest_version": 3,
  "name": "Web Quoter",
  "version": "1.0.0",
  "description": "Save selected text and images as a Markdown file or ZIP with attachments.",
  "permissions": ["contextMenus", "downloads", "storage", "notifications"],
  "options_page": "options.html",
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
